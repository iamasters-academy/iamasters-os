{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{NOMBRE}}",
  "image": "{{URL_FOTO}}",
  "url": "{{URL}}",
  "telephone": "{{TELEFONO}}",
  "priceRange": "{{RANGO_PRECIO}}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{CALLE}}",
    "addressLocality": "{{CIUDAD}}",
    "postalCode": "{{CP}}",
    "addressCountry": "{{PAIS_ISO}}"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{LAT}}",
    "longitude": "{{LON}}"
  },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "{{HH:MM}}",
    "closes": "{{HH:MM}}"
  }]
}
